# ╔══════════════════════════════════════════════════════════╗
# ║                                                          ║
# ║     TISH SEARCH v4 - PRODUCTION ENVIRONMENT              ║
# ║                                                          ║
# ══════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════
# ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ ЭТИ ЗНАЧЕНИЯ!
# ═══════════════════════════════════════════════════════════

# Сгенерируйте уникальный SECRET_KEY:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_UNIQUE_SECRET_KEY_MIN_32_CHARS

# Смените пароль админа!
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here_change_this

# ═══════════════════════════════════════════════════════════
# DATABASE (PostgreSQL для продакшена)
# ═══════════════════════════════════════════════════════════

# PostgreSQL:
DATABASE_URL=postgresql://tish_user:CHANGE_DB_PASSWORD@localhost:5432/tish_db

# Или SQLite (только для тестирования):
# DATABASE_URL=sqlite:///tish_data.db

# ═══════════════════════════════════════════════════════════
# REDIS (для Celery и кэширования)
# ═══════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════
# OLLAMA (AI Model)
# ═══════════════════════════════════════════════════════════

# Если Ollama на том же сервере:
OLLAMA_URL=http://localhost:11434

# Если Ollama на отдельном GPU-сервере:
# OLLAMA_URL=http://10.0.0.50:11434

VISION_MODEL=llava:latest
PRODUCT_SEARCH_USE_OLLAMA=False
PRODUCT_SEARCH_OLLAMA_MODEL=
PRODUCT_SEARCH_MAX_QUERIES=60
PRODUCT_SEARCH_MAX_OLLAMA_VARIANTS=6

# ═══════════════════════════════════════════════════════════
# EMAIL (для восстановления пароля)
# ═══════════════════════════════════════════════════════════

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-app-email@gmail.com
MAIL_PASSWORD=your-app-password-not-real-password

# ═══════════════════════════════════════════════════════════
# MAIN SITE INTEGRATION
# ═══════════════════════════════════════════════════════════

MAIN_SITE_URL=https://tishteam.space
MAIN_SITE_API_URL=https://tishteam.space/api
MAIN_SITE_API_TOKEN=CHANGE_THIS_TO_REAL_SERVER_TOKEN

# ═══════════════════════════════════════════════════════════
# PRODUCTION SETTINGS
# ═══════════════════════════════════════════════════════════

FLASK_ENV=production
FLASK_DEBUG=0

# Количество потоков (рекомендуется: CPU cores * 2)
MAX_WORKERS=4

# Хост и порт
HOST=0.0.0.0
PORT=5000

# ═══════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════

SESSION_COOKIE_SECURE=True  # Только HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=10/minute

# ═══════════════════════════════════════════════════════════
# UPLOADS
# ═══════════════════════════════════════════════════════════

UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=16777216  # 16MB

# ═══════════════════════════════════════════════════════════
# SUPPORT
# ═══════════════════════════════════════════════════════════

SUPPORT_CHANNEL=https://t.me/tishteam_support
TEAM_SITE_URL=https://tishteam.space/

# ═══════════════════════════════════════════════════════════
# CHECKLIST ПЕРЕД ЗАПУСКОМ:
# ═══════════════════════════════════════════════════════════
#
# [ ] SECRET_KEY изменён на уникальный
# [ ] ADMIN_PASSWORD изменён на сложный пароль
# [ ] DATABASE_URL настроен на PostgreSQL
# [ ] MAIL_PASSWORD настроен (не настоящий пароль от Gmail!)
# [ ] MAIN_SITE_API_TOKEN настроен
# [ ] SSL сертификат установлен (для HTTPS)
# [ ] Firewall настроен (только 80, 443, 22)
# [ ] Резервное копирование БД настроено
# [ ] Мониторинг (Sentry, Prometheus) настроен
#
# ═══════════════════════════════════════════════════════════
