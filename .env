# TISH SEARCH Configuration

# Обязательно измените для продакшена!
# Сгенерируйте уникальный ключ: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
SECURITY_PASSWORD_SALT=your-password-salt-change-this

# Admin Panel Credentials (ОБЯЗАТЕЛЬНО измените!)
ADMIN_USERNAME=TISH_TEAM_SEARCH
ADMIN_PASSWORD=0192837456_TICH_TEAM_SEARCH

# Database
# SQLite (для разработки):
DATABASE_URL=sqlite:///tish_data.db
# PostgreSQL (для продакшена):
# DATABASE_URL=postgresql://user:password@localhost:5432/tish_db

# Mail settings (for password recovery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Ollama
OLLAMA_URL=http://localhost:11434
VISION_MODEL=llava:latest
PRODUCT_SEARCH_USE_OLLAMA=False
PRODUCT_SEARCH_OLLAMA_MODEL=
PRODUCT_SEARCH_MAX_QUERIES=60
PRODUCT_SEARCH_MAX_OLLAMA_VARIANTS=6

# Upload settings
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=16777216

# Security
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=10/minute

# Official TISH Team channel for support
SUPPORT_CHANNEL=https://t.me/tishteam_support

# Official TISH Team website (registration redirect)
TEAM_SITE_URL=https://tishteam.space/

# Main site API integration (ВАЖНО!)
MAIN_SITE_URL=https://tishteam.space
MAIN_SITE_API_URL=https://tishteam.space/api
MAIN_SITE_API_TOKEN=CHANGE_THIS_SERVER_TOKEN_FROM_MAIN_SITE

# Production Settings
FLASK_ENV=production
FLASK_DEBUG=0
MAX_WORKERS=4
